--library lime
--library openfl
--library flixel
--library flixel-animate
--library hxp
--library hxcpp

-cp source
-D doc-gen

-D FLX_NO_DEBUG
-D FLX_STANDARD_ASSETS_DIRECTORY
-D FLX_SOUND_SYSTEM

--macro addMetadata('@:build(fvm.util.macro.ZIndexMacro.buildFlxBasic())', 'flixel.FlxBasic')
--macro addMetadata('@:build(fvm.util.macro.ZIndexMacro.buildFlxGroup())', 'flixel.group.FlxTypedGroup')
--macro addMetadata('@:build(fvm.util.macro.ZIndexMacro.buildFlxGroup())', 'flixel.group.FlxTypedSpriteGroup')

--macro include('fvm')

--dce no
--no-output
--each

--next
-neko docs/main.n
-cmd neko docs/main.n
